# ── Google Sheets (persistent database) ──────────────────────────────────────
# Choose ONE authentication method:

# Option A) Google Sheets API key (simplest — works with public/read-only sheets):
# GOOGLE_SHEETS_API_KEY=AIza...

# Option B) Service account credentials (full read/write access):
# GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"-----BEGIN ...\\nEND-----"}

# Your main sales spreadsheet ID (from the URL):
#   https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
SPREADSHEET_ID=

# ── Backup / archive sheet ───────────────────────────────────────────────────
# Separate spreadsheet for archived sales (daily/weekly backups):
# BACKUP_SPREADSHEET_ID=

# ── KRA eTIMS (OSCU S2S) ────────────────────────────────────────────────────
# Set to "true" to use the offline mock for testing — no real OSCU calls:
# KRA_ETIMS_MOCK=true

# Real eTIMS endpoint (required when KRA_ETIMS_MOCK is unset/false):
# KRA_ETIMS_URL=https://script.google.com/macros/s/<YOUR_EXEC_ID>/exec

# ── Auth ─────────────────────────────────────────────────────────────────────
# Random string for signing login tokens — change once on deploy:
APP_SECRET=change-me-to-a-long-random-string

# 4-digit PINs (defaults used if unset):
# Management: Vinnie 2486 · Emma 1947 · Tracy 9503
# Riders:     Wajakoya 7721 · Macharia 3150 · Kamau 6082

# ── M-Pesa webhook ───────────────────────────────────────────────────────────
# OPTIONAL shared secret for the Android SMS forwarder (x-webhook-secret header).
# Leave empty to allow any LAN device to push.
# MPESA_WEBHOOK_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOSTNAME=0.0.0.0
