# ── Google Sheets (required for the persistent database) ─────────────────────
# The long token from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
SPREADSHEET_ID=

# Service account credentials. Use ONE of the following three options:
#
# Option A) Path to a downloaded service-account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
#
# Option B) Inline JSON contents (escape newlines as \n):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN ...\\nEND-----"}
#
# Option C) Email + private key pair:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----....\n-----END PRIVATE KEY-----\n"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Any random string used to sign login tokens. Change this once.
APP_SECRET=change-me-to-a-long-random-string

# 4-digit PINs (defaults used if unset):
# Management: Vinnie 2486 · Emma 1947 · Tracy 9503
# Riders:     Wajakoya 7721 · Macharia 3150 · Kamau 6082
# PIN_VINNIE=2486
# PIN_EMMA=1947
# PIN_TRACY=9503
# PIN_WAJAKOYA=7721
# PIN_MACHARIA=3150
# PIN_KAMAU=6082

# ── M-Pesa webhook ───────────────────────────────────────────────────────────
# OPTIONAL shared secret the Android SMS forwarder must send in the header
# `x-webhook-secret`. Leave empty to allow any LAN device to push.
MPESA_WEBHOOK_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
# Port the PC-side app listens on (Android forwarder posts to this port).
PORT=3000
# Bind all interfaces so the Android phone on the LAN can reach it.
HOSTNAME=0.0.0.0